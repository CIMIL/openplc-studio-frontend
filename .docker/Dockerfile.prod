# syntax=docker/dockerfile:1

# =============================================================================
# Production image for plc-platform-frontend
#
# Multi-stage build:
#   1. builder  -> installs dependencies and builds the Angular app
#   2. runtime  -> serves the compiled static files with unprivileged nginx
#
# This image is static-only: it does NOT proxy /api or /ws. Those routes are
# handled by the platform reverse proxy, matching the dev topology. The SPA uses
# relative URLs, so no runtime configuration is required.
#
# Build (from the plc-platform-frontend directory):
#   docker build -f .docker/Dockerfile.prod -t plc-platform/frontend:prod .
#
# Run:
#   docker run --rm -p 8080:8080 plc-platform/frontend:prod
# =============================================================================

# -----------------------------------------------------------------------------
# Global build arguments (declared before the first FROM so both stages can use
# them, and so they can be overridden with --build-arg).
# -----------------------------------------------------------------------------
ARG NODE_VERSION=22.11.0-alpine3.20
ARG NGINX_VERSION=1.27-alpine

# -----------------------------------------------------------------------------
# Stage 1: build
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS builder

WORKDIR /app

# Give the Angular compiler enough heap for a production build.
ENV NODE_OPTIONS=--max-old-space-size=4096

# Install dependencies first so this layer is cached until the lockfile changes.
COPY package.json package-lock.json .npmrc ./
RUN npm ci --no-audit --no-fund

# Copy the sources and build the production bundle.
# angular.json defaults the build to the "production" configuration, but we pass
# it explicitly for clarity. Output: dist/plc-platform-frontend/browser
COPY . .
RUN npm run build -- --configuration production

# -----------------------------------------------------------------------------
# Stage 2: runtime
# -----------------------------------------------------------------------------
FROM nginxinc/nginx-unprivileged:${NGINX_VERSION} AS runtime

# Static server configuration (no templating / envsubst).
COPY .docker/nginx.prod.conf /etc/nginx/conf.d/default.conf

# Compiled SPA.
COPY --from=builder /app/dist/plc-platform-frontend/browser /usr/share/nginx/html

# The unprivileged image runs as the nginx user; make it explicit.
USER nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/health || exit 1

CMD ["nginx", "-g", "daemon off;"]